.achievements-container {
  width: 100%;
  height: 100dvh;
  overflow-y: auto;
  margin: 0;
  padding: 48px 40px;
  font-family: 'Nunito', sans-serif;
  color: var(--color-text-primary);
  scrollbar-width: none;
  -ms-overflow-style: none;
  
  /* Synced with ActivityPage Skyward Journey theme */
  background-color: #FDFDF9;
  background-image: 
    radial-gradient(rgba(11, 57, 84, 0.1) 1px, transparent 0),
    repeating-radial-gradient(
      circle at 100% 100%, 
      transparent 0, 
      transparent 300px, 
      rgba(5, 150, 105, 0.08) 300px, 
      rgba(5, 150, 105, 0.08) 302px, 
      transparent 302px, 
      transparent 600px
    ),
    repeating-radial-gradient(
      circle at 0% 0%, 
      transparent 0, 
      transparent 400px, 
      rgba(241, 143, 1, 0.07) 400px, 
      rgba(241, 143, 1, 0.07) 402px, 
      transparent 402px, 
      transparent 800px
    );
  background-size: 40px 40px, 100% 100%, 100% 100%;
  background-attachment: fixed;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.achievements-container::-webkit-scrollbar {
  display: none !important;
}

.achievements-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
